    <select id="listNoticeMessageByCurrentNormalUser" resultType="cn.cyberpeace.mp.frontadmin.model.SysNoticeModel">
        select * from (
            select distinct n.* from mp_sys_notice n
            left join mp_sys_notice_org no on n.id = no.notice_id
            left join mp_sys_notice_user nu on n.id = nu.notice_id
            left join mp_sys_notice_role nr on n.id = nr.notice_id
            left join mp_sys_notice_read nre on n.id = nre.notice_id
            <where>
                ((
                n.is_public = 1
                <if test="roles != null and roles.size() > 0">
                    OR
                    nr.role in
                    <foreach item="role" index="index" collection="roles" open="(" separator="," close=")">
                        #{role}
                    </foreach>
                </if>
                )
                AND
                ((
                    no.org is null
                )
                <if test="orgs != null and orgs.size() > 0">
                    OR
                    no.org in
                    <foreach item="org" index="index" collection="orgs" open="(" separator="," close=")">
                        #{org}
                    </foreach>
                </if>
                ))
                <if test="orgs != null and orgs.size() > 0">
                    OR
                    (
                    nr.role is null
                    AND
                    no.org in
                    <foreach item="org" index="index" collection="orgs" open="(" separator="," close=")">
                        #{org}
                    </foreach>
                    )
                </if>
                <if test="userIds != null and userIds.size() > 0">
                OR
                    (
                    nu.user in
                    <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                        #{userId}
                    </foreach>
                    )
                </if>
            </where>
            ) as tabA
        WHERE tabA.id not in (select notice_id from mp_sys_notice_read where user = #{userId} and is_need_push = 0)
        ORDER BY tabA.top desc, tabA.pk desc
    </select>

    <select id="getUnreadCountByCurrentNormalUser" resultType="int">
        select count(*) from (
            select distinct n.* from mp_sys_notice n
            left join mp_sys_notice_org no on n.id = no.notice_id
            left join mp_sys_notice_user nu on n.id = nu.notice_id
            left join mp_sys_notice_role nr on n.id = nr.notice_id
            left join mp_sys_notice_read nre on n.id = nre.notice_id
            <where>
                ((
                n.is_public = 1
                <if test="roles != null and roles.size() > 0">
                    OR
                    nr.role in
                    <foreach item="role" index="index" collection="roles" open="(" separator="," close=")">
                        #{role}
                    </foreach>
                </if>
                )
                AND
                ((
                    no.org is null
                )
                <if test="orgs != null and orgs.size() > 0">
                    OR
                    no.org in
                    <foreach item="org" index="index" collection="orgs" open="(" separator="," close=")">
                        #{org}
                    </foreach>
                </if>
                ))
                <if test="orgs != null and orgs.size() > 0">
                    OR
                    (
                    nr.role is null
                    AND
                    no.org in
                    <foreach item="org" index="index" collection="orgs" open="(" separator="," close=")">
                        #{org}
                    </foreach>
                    )
                </if>
                <if test="userIds != null and userIds.size() > 0">
                    OR
                    (
                    nu.user in
                    <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                        #{userId}
                    </foreach>
                    )
                </if>
            </where>
            ) as tabA
        WHERE tabA.id not in (select notice_id from mp_sys_notice_read where user = #{userId} and (is_readed = 1 or
        is_need_push = 0))
    </select>

</mapper>
