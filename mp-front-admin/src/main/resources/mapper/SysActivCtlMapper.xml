<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.front.admin.repository.SysActivCtlMapper">
    
    <select id="selectAll" resultType="cn.cyberpeace.mp.front.admin.model.SysActivCtlModel">
        select * from mp_front_admin_activ_ctl
