<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.front.admin.repository.MenuExtraInfoMapper">

    <select id="listAll" resultType="cn.cyberpeace.mp.front.admin.model.MenuExtraInfoModel">
        select *
        from mp_front_admin_menu_extra_info
    </select>

    <delete id="deleteAll">
        delete
        from mp_front_admin_menu_extra_info
        where pk > 0
    </delete>

</mapper>
