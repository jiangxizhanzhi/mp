<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.frontadmin.repository.SysNoticeUserMapper">

    <select id="listByNoticeIds" resultType="cn.cyberpeace.mp.auth.model.UserModel">
        select distinct u.* from mp_auth_user u left join mp_sys_notice_user nu on u.id = nu.user
        <where>
            <if test="noticeIds != null and noticeIds.size() > 0">
                AND nu.notice_id in
                <foreach item="noticeId" index="index" collection="noticeIds" open="(" separator="," close=")">
                    #{noticeId}
                </foreach>
            </if>
        </where>
    </select>

