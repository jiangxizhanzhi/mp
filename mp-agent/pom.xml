<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.cyberpeace.mp</groupId>
        <artifactId>mp</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.cyberpeace.mp.agent</groupId>
    <artifactId>mp-agent</artifactId>
    <version>0.0.2-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>mp-agent</name>

    <properties/>

    <dependencies>
        <dependency>
            <groupId>cn.cyberpeace.mp</groupId>
            <artifactId>mp-base</artifactId>
            <version>0.0.2-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cy.cyberpeace</groupId>
            <artifactId>netconf-java</artifactId>
            <version>2.1.1.7</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/netconf-java-2.1.1.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cy.cyberpeace</groupId>
            <artifactId>dom4j</artifactId>
            <version>2.0.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/dom4j-2.0.1.jar</systemPath>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>