<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志级别从低到高分为TRACE < DEBUG < INFO < WARN < ERROR < FATAL，如果设置为WARN，则低于WARN的信息都不会输出 -->
<!-- scan:当此属性设置为true时，配置文件如果发生改变，将会被重新加载，默认值为true -->
<!-- scanPeriod:设置监测配置文件是否有修改的时间间隔，如果没有给出时间单位，默认单位是毫秒。当scan为true时，此属性生效。默认的时间间隔为1分钟。 -->
<!-- debug:当此属性设置为true时，将打印出logback内部日志信息，实时查看logback运行状态。默认值为false。 -->
<configuration scan="true" scanPeriod="60 seconds" debug="false">

    <!--引用默认日志配置-->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!--使用默认的控制台日志输出实现-->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 彩色日志 -->
    <!-- 彩色日志依赖的渲染类 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <conversionRule conversionWord="CALL_CHAIN_ID" converterClass="cn.cyberpeace.mp.base.config.log.CallChainIdConverter"/>

    <!-- 日志格式 -->
    <!-- 时间 [线程名称] 日志等级 调用模块 - 调用源id | {具体的message} -->
    <!-- 线程名称为 ${PID}-${thread}   -->
    <!-- 调用模块为 logger -->
    <!-- 调用源id为 追踪id -->

    <!-- 控制台日志 -->
    <property name="CONSOLE_LOG_PATTERN" value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([${PID}-%thread]){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(%-40.40logger{39}){cyan} %L %clr(-){faint} %clr(%CALL_CHAIN_ID){faint} %clr(|){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <!-- 同步输出文件日志 使用 %CALL_CHAIN_ID 打印追踪id  -->
<!--    <property name="FILE_LOG_PATTERN" value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} [${PID:-}-%thread] ${LOG_LEVEL_PATTERN:-%5p} %-40.40logger{39} %L - %CALL_CHAIN_ID | %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>-->
    <!-- 异步输出文件日志 使用 %X{CALL_CHAIN_ID} 打印追踪id  -->
    <property name="FILE_LOG_PATTERN" value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} [${PID:-}-%thread] ${LOG_LEVEL_PATTERN:-%5p} %-40.40logger{39} %L - %X{CALL_CHAIN_ID} | %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!--应用名称-->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="mp"/>
    <!--日志路径-->
    <springProperty scope="context" name="LOG_FILE_PATH" source="logging.file.path" defaultValue="/logs"/>
    <!--日志级别-->
    <springProperty scope="context" name="LOG_LEVEL_ROOT" source="logging.level.root" defaultValue="ERROR"/>
    <!--日志最大天数-->
    <springProperty scope="context" name="LOG_FILE_MAX_HISTORY" source="logging.level.maxdays" defaultValue="7"/>

    <property name="LOG_HOME" value="${LOG_FILE_PATH}"/>
    <property name="LOG_LEVEL" value="${LOG_LEVEL_ROOT}"/>
    <property name="LOG_FILE_MAX_SIZE" value="300MB"/>
    <property name="LOG_FILE_MAX_HISTORY" value="${LOG_FILE_MAX_HISTORY}"/>

    <!-- 控制台日志输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 时间滚动输出日志 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/mp.log</file>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志归档 -->
            <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}.log</fileNamePattern>
            <!--日志文件保留天数-->
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--异步打印日志,任务放在阻塞队列中，如果队列达到80%，将会丢弃TRACE,DEBUG,INFO级别的日志任务，对性能要求不是太高的话不用启用-->
    <appender name="ASYNC" class="cn.cyberpeace.mp.base.config.log.MpAsyncAppender">
        <!--队列的深度，该值会影响性能，默认256-->
        <queueSize>512</queueSize>
        <!--设为0表示队列达到80%，也不丢弃任务-->
        <discardingThreshold>0</discardingThreshold>
        <!--日志上下文关闭后，AsyncAppender继续执行写任务的时间，单位毫秒-->
        <maxFlushTime>1000</maxFlushTime>
        <!--队列满了直接丢弃要写的消息-->
        <neverBlock>true</neverBlock>
        <!--是否包含调用方的信息，false则无法打印类名方法名行号等-->
        <includeCallerData>true</includeCallerData>
        <!--One and only one appender may be attached to AsyncAppender，添加多个的话后面的会被忽略-->
        <appender-ref ref="FILE"/>
    </appender>

    <!--日志输出级别-->
    <root level="${LOG_LEVEL}">
        <!-- 控制台输出 -->
        <appender-ref ref="CONSOLE"/>
        <!-- 文件输出 需要注意选择同步或者异步输出的格式 -->
        <appender-ref ref="ASYNC"/>
    </root>

</configuration>