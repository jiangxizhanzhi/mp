<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.TenantMapper">
    <select id="list" resultType="cn.cyberpeace.mp.auth.model.TenantModel">
        SELECT <include refid="cn.cyberpeace.mp.base.selectFields" />
        FROM mp_auth_tenant
        <include refid="cn.cyberpeace.mp.base.pagination" />
    </select>
    <select id="total" resultType="java.lang.Integer">
        SELECT <include refid="cn.cyberpeace.mp.base.totalField" />
        FROM mp_auth_tenant
    </select>
    <select id="get" resultType="cn.cyberpeace.mp.auth.model.TenantModel">
        SELECT <include refid="cn.cyberpeace.mp.base.selectFields" />
        FROM mp_auth_tenant
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </select>
    <insert id="create">
        INSERT INTO mp_auth_tenant <include refid="cn.cyberpeace.mp.base.createFields" />
        VALUES
               (
                   #{id},
                   #{identifier},
                   #{name},
                   #{createTime},
                   #{updateTime}
               )
    </insert>
    <update id="update">
        UPDATE mp_auth_tenant
        SET
            identifier=#{identifier},
            name=#{name},
            update_time=#{updateTime}
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </update>
    <delete id="delete">
        DELETE FROM mp_auth_tenant WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </delete>
</mapper>
