<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.UserOnlineReportMapper">

    <select id="listAll" resultType="cn.cyberpeace.mp.auth.model.UserOnlineReportModel">
        select * from mp_auth_user_online_report order by is_online desc, username
    </select>
    
    <select id="getByUserId" resultType="cn.cyberpeace.mp.auth.model.UserOnlineReportModel">
        select * from mp_auth_user_online_report where user = #{userId}
    </select>
</mapper>
