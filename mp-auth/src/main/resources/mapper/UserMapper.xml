<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.UserMapper">

    <select id="getUserCnt" resultType="int">
        select count(id) from mp_auth_user
    </select>

    <update id="updateIdentToNull">
        update mp_auth_user set identifier = null where id = #{id}
    </update>
</mapper>
