<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.UserOnlineRecordMapper">

    <select id="listRecordSummary" resultType="cn.cyberpeace.mp.auth.dto.user.UserOnlineRecordSummaryDto">
        select user, sum(duration_minutes) total_online_minutes, sum(status = 0) unCompleteCnt, mp_auth_user.username, mp_auth_user.name
        from mp_auth_user_online_record
        left join mp_auth_user on mp_auth_user_online_record.user = mp_auth_user.id
        <where>
            mp_auth_user.username is not null
            <if test="userIds != null and userIds.size() > 0">
                AND user IN
                <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
        </where>
        group by user
        order by unCompleteCnt desc,
        <if test="priorityUserIds != null and priorityUserIds.size() > 0">
            (case when user IN
            <foreach item="priorityUserId" index="index" collection="priorityUserIds" open="(" separator="," close=")">
                #{priorityUserId}
            </foreach>
            then 1 ELSE 2 END),
        </if>
        total_online_minutes desc
    </select>

    <select id="listCurrentOnlined" resultType="cn.cyberpeace.mp.auth.model.UserOnlineRecordModel">
        select * from mp_auth_user_online_record
        <where>
            <if test="userIds != null and userIds.size() > 0">
                AND user IN
                <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
            <if test="minutes != null">
                AND end_time &gt; NOW() - INTERVAL #{minutes} MINUTE
            </if>
            AND status = 0
        </where>
    </select>

    <select id="listCurrentOfflined" resultType="cn.cyberpeace.mp.auth.model.UserOnlineRecordModel">
        select * from mp_auth_user_online_record
        <where>
            <if test="userIds != null and userIds.size() > 0">
                AND user IN
                <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
            <if test="minutes != null">
                AND end_time &lt; NOW() - INTERVAL #{minutes} MINUTE
            </if>
            AND status = 0
        </where>
    </select>

