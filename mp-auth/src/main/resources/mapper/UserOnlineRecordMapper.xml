<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.UserOnlineRecordMapper">

    <select id="listOnlined" resultType="cn.cyberpeace.mp.auth.model.UserOnlineRecordModel">
        select * from mp_auth_user_online_record
        <where>
            <if test="#{userId} != null and #{userId} != ''">
                AND user = #{userId}
            </if>
            <if test="#{deadline} != null">
                AND end_time > #{deadline}
            </if>
            AND status = 0
        </where>
    </select>

    <select id="listOfflined" resultType="cn.cyberpeace.mp.auth.model.UserOnlineRecordModel">
        select * from mp_auth_user_online_record
        <where>
            <if test="#{userId} != null and #{userId} != ''">
                AND user = #{userId}
            </if>
            <if test="#{deadline} != null">
                AND end_time &lt; #{deadline}
            </if>
            AND status = 0
        </where>
    </select>

    <select id="getByUserId" resultType="cn.cyberpeace.mp.auth.model.UserOnlineRecordModel">
        select *
        from mp_auth_user_online_record
        where user = #{userId}
    </select>
</mapper>
