<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.TeamMapper">


    <select id="existTeamList" resultType="cn.cyberpeace.mp.auth.model.TeamModel">
        select * from mp_auth_team where 1=1 AND name IN
        <foreach item="name" index="index" collection="teamList" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>
</mapper>
