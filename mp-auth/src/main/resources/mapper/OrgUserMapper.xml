<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.OrgUserMapper">


    <select id="listUsersByOrgId" resultType="cn.cyberpeace.mp.auth.model.UserModel">
        select distinct * from mp_auth_user where id in
            (select user from mp_auth_org_user where org = #{orgId})
            <if test="excludeRoleIds != null and excludeRoleIds.size() > 0">
                AND id not in
                (select distinct user from mp_auth_user_role where role in
                <foreach item="roleId" index="index" collection="excludeRoleIds" open="(" separator="," close=")">
                    #{roleId}
                </foreach>
                )
            </if>
            order by mp_auth_user.username
    </select>

    <select id="listOrgsByUserId" resultType="cn.cyberpeace.mp.auth.model.OrgModel">
        select distinct * from mp_auth_org where id in
            (select org from mp_auth_org_user where user = #{userId})
            order by mp_auth_org.pk
    </select>

    <select id="listUsers" resultType="cn.cyberpeace.mp.auth.model.UserModel">
        select distinct * from mp_auth_user
        <where>
            <if test="orgIds != null and orgIds.size() > 0">
                AND id in (select user from mp_auth_org_user where org in
                <foreach item="orgId" index="index" collection="orgIds" open="(" separator="," close=")">
                    #{orgId}
                </foreach>
                )
            </if>
            <if test="userIds != null and userIds.size() > 0">
                AND id in
                <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
            <if test="excludeRoleIds != null and excludeRoleIds.size() > 0">
                AND id not in
                (select distinct user from mp_auth_user_role where role in
                    <foreach item="roleId" index="index" collection="excludeRoleIds" open="(" separator="," close=")">
                         #{roleId}
                    </foreach>
                )
            </if>
            <if test="userCondition.isEnabled != null">
                AND is_enabled = #{userCondition.isEnabled}
            </if>
            <if test="userCondition.isAudited != null">
                AND is_audited = #{userCondition.isAudited}
            </if>
            <if test="userCondition.isExpired != null and userCondition.isExpired == 0">
                AND expired_time > now()
            </if>
            <if test="userCondition.isExpired != null and userCondition.isExpired != 0">
                AND expired_time &lt;= now()
            </if>
            <if test="userCondition.username != null and userCondition.username != ''">
                AND ( username like CONCAT('%', #{userCondition.username}, '%') or name like CONCAT('%',
                #{userCondition.username}, '%'))
            </if>
        </where>
        <if test="orders != null and orders.size() > 0">
            ORDER BY
            <foreach item="order" index="index" collection="orders"
                     open="" separator="," close="">${order}
            </foreach>
        </if>
    </select>

    <select id="selectUserCnt" resultType="integer">
        select count(*)
        from mp_auth_org_user
        where org = #{orgId}
    </select>

    <delete id="deleteByUserId">
        delete
        from mp_auth_org_user
        where user = #{userId}
    </delete>

    <delete id="deleteByOrgId">
        delete
        from mp_auth_org_user
        where org = #{orgId}
    </delete>

</mapper>
