<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.SysNoticeReadMapper">

    <select id="selectByUserIdAndNoticeId" resultType="cn.cyberpeace.mp.auth.model.RoleModel">
        select * from mp_sys_notice_read
        <where>
            <if test="user != null and user != ''">
                AND user = #{user}
            </if>
            <if test="noticeId != null and noticeId != ''">
                AND notice_id = #{noticeId}
            </if>
        </where>
    </select>

</mapper>
