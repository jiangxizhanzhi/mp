<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.RolePermissionMapper">

    <select id="listTargetsByRoleId" resultType="cn.cyberpeace.mp.auth.model.TargetModel">
        select distinct *
        from mp_auth_target
        where id in
              (select target from mp_auth_role_permission where owner = #{roleId})
    </select>

    <delete id="deleteByOwner">
        delete
        from mp_auth_role_permission
        where owner = #{owner}
    </delete>

    <delete id="deleteByTarget">
        delete
        from mp_auth_role_permission
        where target = #{target}
    </delete>

</mapper>
