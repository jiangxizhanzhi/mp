<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.OrgMapper">

    <insert id="insert" parameterType="cn.cyberpeace.mp.auth.model.OrgModel">
        INSERT INTO mp_auth_org `(id`, `tenant`, `parent`, `identifier`, `name`, `path`, `description`,
                                       `create_time`, `update_time`)
        VALUES ( #{id}, #{tenant}, #{parent}, #{identifier}, #{name}, NULL, #{description}, #{createTime}, #{updateTime});
    </insert>

</mapper>
