<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.MicrosoftAzureLoginMapper">

    <select id="getMicrosoftAzureUserList" resultType="cn.cyberpeace.mp.auth.model.MicrosoftAzureUserModel">
        SELECT
            *
        FROM
            mp_auth_cloud_user
        <where>
            <if test="param != null and param.cloudType != null and param.cloudType != ''">
                and cloud_type = #{param.cloudType}
            </if>
        </where>
    </select>

</mapper>
