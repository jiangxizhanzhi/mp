<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.SysNoticeRoleMapper">

    <select id="listByNoticeIds" resultType="cn.cyberpeace.mp.auth.model.RoleModel">
        select distinct r.* from mp_auth_role r left join mp_sys_notice_role nr on r.id = nr.role
        <where>
            <if test="noticeIds != null and noticeIds.size() > 0">
                AND nr.notice_id in
                <foreach item="noticeId" index="index" collection="noticeIds" open="(" separator="," close=")">
                    #{noticeId}
                </foreach>
            </if>
        </where>
    </select>

    <delete id="deleteByNoticeIds">
        delete from mp_sys_notice_role
        <where>
            <if test="noticeIds != null and noticeIds.size() > 0">
                AND notice_id in
                <foreach item="noticeId" index="index" collection="noticeIds" open="(" separator="," close=")">
                    #{noticeId}
                </foreach>
            </if>
        </where>
    </delete>

    <delete id="deleteByRole">
        delete from mp_sys_notice_role where role = #{roleId}
    </delete>

</mapper>
