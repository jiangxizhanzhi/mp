<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.PersonnelManagementMapper">


    <select id="getUserExist" resultType="cn.cyberpeace.mp.auth.model.PersonnelManagementModel">
        select * from mp_auth_personnel_management where team_id != #{teamId}
        AND user_id IN
        <foreach item="userId" index="index" collection="userIds" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>
</mapper>
