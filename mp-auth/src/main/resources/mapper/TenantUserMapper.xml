<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.auth.repository.TenantUserMapper">


    <select id="getGroupByOrg" resultType="cn.cyberpeace.mp.auth.bo.org.OrgIdAndCount">
        SELECT count(1) as count ,org as orgId FROM `mp_auth_tenant_user` GROUP BY org
    </select>
</mapper>
