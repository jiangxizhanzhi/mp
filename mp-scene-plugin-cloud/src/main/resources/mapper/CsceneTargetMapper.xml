<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cyberpeace.mp.sceneplugincloud.repository.CsceneTargetMapper">


    <select id="findByEid" resultType="cn.cyberpeace.mp.sceneplugincloud.bo.CsceneTargetBO">
        select * from mp_devops_target where uuid = #{ids}
    </select>

    <select id="findByName" resultType="cn.cyberpeace.mp.sceneplugincloud.bo.CsceneTargetBO">
        select * from mp_devops_target where name = #{name} and instance_state != 0
    </select>
    <select id="findByUUid" resultType="cn.cyberpeace.mp.sceneplugincloud.bo.CsceneTargetBO">
        select * from mp_devops_target where uuid in
        <foreach item="item" collection="uuids" open="(" separator="," close=")">
        #{item}
        </foreach>
    </select>

</mapper>