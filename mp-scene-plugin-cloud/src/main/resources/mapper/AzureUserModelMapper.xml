<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.sceneplugincloud.repository.AzureUserModelMapper">

    <select id="getLocalAzurer" resultType="cn.cyberpeace.mp.sceneplugincloud.model.AzureUserModel">
        SELECT
        *
        FROM
        mp_auth_cloud_user
        <where>
            <if test="param != null and param.cloudType != null and param.cloudType != ''">
                and cloud_type = #{param.cloudType}
            </if>
        </where>
        ORDER BY
        version DESC
        limit 1
    </select>
</mapper>
