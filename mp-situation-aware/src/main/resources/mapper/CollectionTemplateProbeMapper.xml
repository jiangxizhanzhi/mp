<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cyberpeace.mp.situationaware.repository.CollectionTemplateProbeMapper">
  <resultMap id="BaseResultMap" type="cn.cyberpeace.mp.situationaware.model.CollectionTemplateProbeModel">
    <id column="pk" jdbcType="INTEGER" property="pk" />
    <result column="id" jdbcType="VARCHAR" property="id" />
    <result column="template_id" jdbcType="VARCHAR" property="templateId" />
    <result column="probe_id" jdbcType="VARCHAR" property="probeId" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="description" jdbcType="VARCHAR" property="description" />
    <result column="probe_category" jdbcType="INTEGER" property="probeCategory" />
    <result column="type" jdbcType="INTEGER" property="type" />
    <result column="output_format" jdbcType="VARCHAR" property="outputFormat" />
    <result column="engine" jdbcType="VARCHAR" property="engine" />
    <result column="OS_type" jdbcType="VARCHAR" property="osType" />
    <result column="disabled" jdbcType="INTEGER" property="disabled" />
    <result column="script_url" jdbcType="VARCHAR" property="scriptUrl" />
    <result column="interval_sec" jdbcType="INTEGER" property="intervalSec" />
    <result column="config" jdbcType="VARCHAR" property="config" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
  </resultMap>


  <delete id="deleteByTemplateId">
    delete from mp_situation_collection_template_probe
    where template_id = #{templateId}
  </delete>

  <delete id="deleteByTemplateIds">
    delete from mp_situation_collection_template_probe
    <where>
      template_id in
      <if test="templateIds != null and templateIds.length > 0">
        <foreach item="templateId" index="index" collection="templateIds" open="(" separator="," close=")">
          #{templateId}
        </foreach>
      </if>
    </where>
  </delete>

  <select id="countByTemplateId" resultType="integer">
    select count(*) from mp_situation_collection_template_probe tempp
    left join mp_situation_probe p on tempp.probe_id = p.id
    <where>
      template_id = #{templateId}
      <if test="type != null">
        AND p.type = #{type}
      </if>
    </where>
  </select>

  <select id="listCollectionTemplateProbeDtos" resultType="cn.cyberpeace.mp.situationaware.model.dto.collection.CollectionTemplateProbeDto">
    select tempp.probe_id,
           tempp.template_id,
           tempp.disabled,
           tempp.script_url,
           tempp.interval_sec as template_probe_interval_sec,
           tempp.config,
           p.`name`,
           p.description,
           p.probe_category,
           p.`type`,
           p.creator,
           p.interval_sec,
           p.output_format,
           p.is_deleted,
           p.OS_type,
           p.create_time,
           p.update_time
    from mp_situation_collection_template_probe tempp
           left join mp_situation_probe p on p.id = tempp.probe_id
    <where>
        tempp.template_id = #{templateId}
        <if test="probeCondition.ids != null and probeCondition.ids.length > 0">
          AND p.id in
          <foreach item="pid" index="index" collection="probeCondition.ids" open="(" separator="," close=")">
            #{pid}
          </foreach>
        </if>
        <if test="probeCondition.types != null and probeCondition.types.length > 0">
          AND p.type in
          <foreach item="type" index="index" collection="probeCondition.types" open="(" separator="," close=")">
            #{type}
          </foreach>
        </if>
        <if test="probeCondition.probeCategories != null and probeCondition.probeCategories.length > 0">
          AND p.probe_category in
          <foreach item="category" index="index" collection="probeCondition.probeCategories" open="(" separator="," close=")">
            #{category}
          </foreach>
        </if>
    </where>
    order by tempp.pk
  </select>

    <select id="listCollectionTemplateProbeModels" resultMap="BaseResultMap">
        select * from mp_situation_collection_template_probe
        <where>
            template_id = #{templateId}
            <if test="probeCondition.ids != null and probeCondition.ids.length > 0">
                AND probe_id in
                <foreach item="pid" index="index" collection="probeCondition.ids" open="(" separator="," close=")">
                    #{pid}
                </foreach>
            </if>
            <if test="probeCondition.types != null and probeCondition.types.length > 0">
                AND type in
                <foreach item="type" index="index" collection="probeCondition.types" open="(" separator="," close=")">
                    #{type}
                </foreach>
            </if>
            <if test="probeCondition.probeCategories != null and probeCondition.probeCategories.length > 0">
                AND probe_category in
                <foreach item="category" index="index" collection="probeCondition.probeCategories" open="(" separator="," close=")">
                    #{category}
                </foreach>
            </if>
        </where>
        order by pk
    </select>

  <select id="listCustomProbesNotInTemplate" resultType="cn.cyberpeace.mp.situationaware.model.ProbeModel">
    select * from mp_situation_probe
    <where>
      id not in
      (select p.id from mp_situation_collection_template_probe tempp
      left join mp_situation_probe p on tempp.probe_id = p.id
      where tempp.template_id = #{templateId})
      AND type = 1
      <if test="category != null">
        AND probe_category = #{category}
      </if>
      <if test="probeName != null and probeName != ''">
        AND name like CONCAT('%', #{probeName}, '%')
      </if>
      AND is_deleted = 0
    </where>
  </select>

  <select id="listCustomProbes" resultType="cn.cyberpeace.mp.situationaware.model.ProbeModel">
    select * from mp_situation_probe
    <where>
      AND type = 1
      <if test="category != null">
        AND probe_category = #{category}
      </if>
      <if test="probeName != null and probeName != ''">
        AND name like CONCAT('%', #{probeName}, '%')
      </if>
      AND is_deleted = 0
    </where>
  </select>
</mapper>
