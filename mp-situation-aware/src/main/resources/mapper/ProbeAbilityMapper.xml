  <select id="listProbeAbilityDtos" resultType="cn.cyberpeace.mp.situationaware.model.dto.probe.ProbeAbilityDto">
    select pa.*, p.id as probe_id, p.name as probe_name
    from mp_situation_probe_ability pa
    left join mp_situation_probe p
    on p.id = pa.probe_id
    <where>
      p.is_deleted = 0
      AND p.type = 0
      <if test="condition.ids != null and condition.ids.length > 0">
        AND p.id in
        <foreach item="pid" index="index" collection="condition.ids" open="(" separator="," close=")">
          #{pid}
        </foreach>
      </if>
      <if test="condition.abilityIds != null and condition.abilityIds.length > 0">
        AND pa.id in
        <foreach item="aid" index="index" collection="condition.abilityIds" open="(" separator="," close=")">
          #{aid}
        </foreach>
      </if>
      <if test="condition.probeCategories != null and condition.probeCategories.length > 0">
        AND p.probe_category in
        <foreach item="category" index="index" collection="condition.probeCategories" open="(" separator="," close=")">
          #{category}
        </foreach>
      </if>
      <if test="condition.types != null and condition.types.length > 0">
        AND p.type in
        <foreach item="type" index="index" collection="condition.types" open="(" separator="," close=")">
          #{type}
        </foreach>
      </if>
      <if test="condition.name != null and condition.name != ''">
        AND p.name like CONCAT('%', #{condition.name}, '%')
      </if>
      <if test="condition.abilityName != null and condition.abilityName != ''">
        AND pa.name like CONCAT('%', #{condition.abilityName}, '%')
      </if>
      <if test="condition.osTypes != null and condition.osTypes.length > 0">
        AND
        <foreach item="osType" index="index" collection="condition.osTypes" open="(" separator="OR" close=")">
          p.OS_type like CONCAT('%', #{osType}, '%')
        </foreach>
      </if>
    </where>
    order by pa.pk
  </select>
