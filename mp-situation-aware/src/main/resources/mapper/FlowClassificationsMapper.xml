<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.situationaware.repository.FlowClassificationsMapper">

    <resultMap id="BaseResultMap" type="cn.cyberpeace.mp.situationaware.model.FlowClassificationModel">
        <id column="pk" property="pk"/>
        <result column="id"  property="id"/>
        <result column="category_en"  property="categoryEn"/>
        <result column="category_zh"  property="categoryZh"/>
    </resultMap>

    <sql id="baseColumn">
        id,
        category_en,
        category_zh
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        select <include refid="baseColumn"/> from mp_situation_flow_classification
    </select>

    <delete id="deleteAll">
        delete from mp_situation_flow_classification
    </delete>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into mp_situation_flow_classification( id, category_en,category_zh,create_time)
        VALUES
        <foreach collection="list" item="item" index="index"  separator=",">
        (
            #{item.id},#{item.categoryEn},#{item.categoryZh},now()
        )
        </foreach>
    </insert>

</mapper>
