<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.behavior.repository.NetworkBehaviorMapper">

    <select id="getBehaviorList" resultType="cn.cyberpeace.mp.behavior.res.BehaviorBo">
        select id, name, params
        from mp_network_behavior
        order by update_time desc
    </select>
</mapper>
