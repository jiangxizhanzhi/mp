<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.behavior.repository.CsceneNetworkBehaviorMapper">

    <select id="getTopoAllByNodeId" resultType="cn.cyberpeace.mp.behavior.model.CsceneNetworkBehaviorModel">
        select *
        from mp_cscene_network_behavior
        where node_id = #{nodeId} and (scene_id is null or scene_id = '')
    </select>

    <select id="getTopoAllByIds" resultType="cn.cyberpeace.mp.behavior.model.CsceneNetworkBehaviorModel">
        select *
        from mp_cscene_network_behavior
        <where>
            (scene_id is null or scene_id = '')
            <if test="ids != null and ids.size() != 0">
                and id in
                <foreach collection="ids" separator="," open="(" close=")" item="id">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <delete id="deleteTopoByNodeId">
        delete
        from mp_cscene_network_behavior
        where node_id = #{nodeId} and (scene_id is null or scene_id = '')
    </delete>

    <delete id="deleteBySceneId">
        delete
        from mp_cscene_network_behavior
        where scene_id = #{sceneId}
    </delete>
</mapper>
