<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.behavior.mapper.SimulateMapper">

    <select id="countSimulate" resultType="java.lang.Integer">
        select count(1) from mp_behavior_simulate where `delete` is false
    </select>

    <select id="selectBySceneNode" resultType="cn.cyberpeace.mp.behavior.model.SimulateModel">
        select *
        from mp_behavior_simulate
        where scene_id = #{scene_id} and node_id = #{node_id}
    </select>

    <select id="selectIdByStatus" resultType="java.lang.String">
        select id
        from mp_behavior_simulate
        where status = #{status} and `delete` is false
    </select>

    <update id="delete">
        update mp_behavior_simulate
        set `delete` = true
        where id in
            <foreach collection="ids" separator="," open="(" close=")" item="id">
                #{id}
            </foreach>
    </update>

    <select id="getNameList" resultType="java.lang.String">
        select DISTINCT scene_name
        from mp_behavior_simulate
    </select>
</mapper>
