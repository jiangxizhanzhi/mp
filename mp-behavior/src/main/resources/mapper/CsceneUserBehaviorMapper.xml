<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.behavior.repository.CsceneUserBehaviorMapper">

    <select id="getTopoAllByNodeId" resultType="cn.cyberpeace.mp.behavior.model.CsceneUserBehaviorModel">
        select *
        from mp_cscene_user_behavior
        where node_id = #{nodeId} and (scene_id is null or scene_id = '')
    </select>

    <select id="getTopoAllByNodeIds" resultType="cn.cyberpeace.mp.behavior.model.CsceneUserBehaviorModel">
        select *
        from mp_cscene_user_behavior
        <where>
            (scene_id is null or scene_id = '')
            <if test="nodeIds != null and nodeIds.size() != 0">
                and node_id in
                <foreach collection="nodeIds" item="nodeId" open="(" close=")" separator=",">
                    #{nodeId}
                </foreach>
            </if>
        </where>
    </select>

    <delete id="deleteTopoByNodeId">
        delete
        from mp_cscene_user_behavior
        where node_id = #{nodeId} and (scene_id is null or scene_id = '')
    </delete>

    <delete id="deleteBySceneId">
        delete
        from mp_cscene_user_behavior
        where scene_id = #{sceneId}
    </delete>
</mapper>
