# -*- coding: utf-8 -*-
import argparse
import os
import json

if os.name == 'nt':
    LOG_FILE = "C:\\ossec-agent\\cmd-launcher.log"
else:
    LOG_FILE = "/var/ossec/logs/cmd-launcher.log"

OS_SUCCESS = 0
OS_INVALID = -1


def write_debug_file(msg):
    with open(LOG_FILE, mode="a") as log_file:
        log_file.write(msg +"\n")

def get_file_list(file_path_list):
    arr = []
    cur_sep = os.path.sep
    for file_path in file_path_list:
        if os.path.exists(file_path):
            if os.path.isdir(file_path):
                for file in os.listdir(file_path):
                    filePatha = file_path + cur_sep + file
                    stat = os.stat(filePatha)
                    arr.append(filePatha+"---file_size---"+str(stat.st_size))
                    cmd_info = {
                        "sic_launch_id": "909651719b054ebca6a3226f18f27000",
                        "sic_launch_input": { "matcher": "cmd", "output_format": "json"},
                        "sic_launch_output": {"data":filePatha+"---file_size---"+str(stat.st_size)}
                    }
                    write_debug_file(json.dumps(cmd_info))
            arr.append(file_path)
        else:
            cmd_info = {
                        "sic_launch_id": "909651719b054ebca6a3226f18f27000",
                        "sic_launch_input": { "matcher": "cmd", "output_format": "json"},
                        "sic_launch_output": {"data":file_path+"---file_not_exists---"}
                    }
            write_debug_file(json.dumps(cmd_info))
            arr.append(file_path+"---file_not_exists---")
    return arr


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument("files", help="list of files")
    args = parser.parse_args()
    files = str(args.files).split(',')
    print(get_file_list(files))
