<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.cscene.repository.CSceneElementCountMapper">
    <update id="updateElementCount" parameterType="java.util.Map">
        update mp_cscene_element_count
        set count = count + #{count}
        where count + #{count} &lt;= #{limit} and count + #{count } &gt;= 0;
    </update>
</mapper>
