<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.cscene.repository.AzureVmSizeMapper">

    <insert id="batchInsert">
        insert into mp_azure_vm_size (
        id,
        name,
        vcpu,
        ram,
        max_data_disks,
        max_nics,
        create_time,
        update_time
        )
        values
        <foreach collection="azureVmSizes" item="item" separator=",">
            (
            REPLACE(UUID(), '-', ''),
            #{item.name},
            #{item.vCPUs},
            #{item.MemoryGB},
            #{item.MaxDataDiskCount},
            #{item.MaxNetworkInterfaces},
            now(),
            now()
            )
        </foreach>
    </insert>
    <delete id="truncate">
        truncate table mp_azure_vm_size
    </delete>
