<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cyberpeace.mp.cscene.repository.ScreenshotMapper">

    <select id="queryUsedSpace" resultType="java.lang.Long">
        select
            sum(s.file_size)
        from
            mp_devops_screenshot s
    </select>

    <select id="queryByCreateTime" resultType="cn.cyberpeace.mp.cscene.model.ScreenshotModel">
        select s.*
        from
            mp_devops_screenshot s
        <where>
            <if test=" createTime != null and createTime != ''">
                <![CDATA[
                    s.create_time < #{createTime}
                ]]>
            </if>
        </where>
    </select>

    <select id="selectByIds" resultType="cn.cyberpeace.mp.cscene.model.ScreenshotModel">
        select s.* from mp_devops_screenshot s
        <where>
            1 = 1
            <if test="ids != null and ids.size() > 0">
                AND s.id in
                <foreach item="id" index="index" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

</mapper>