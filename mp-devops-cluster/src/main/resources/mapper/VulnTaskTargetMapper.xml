<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.devopscluster.repository.VulnTaskTargetMapper">

    <resultMap id="BaseResultMap" type="cn.cyberpeace.mp.devopscluster.po.VulnTaskTargetPO">
        <id column="pk" property="pk"/>
        <result column="id"  property="id"/>
        <result column="record_id"  property="recordId"/>
        <result column="record_name"  property="recordName"/>
        <result column="node"  property="node"/>
        <result column="images" property="images"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findByTaskIdAndNode" parameterType="java.lang.String" resultMap="BaseResultMap">
        select * from mp_devops_task_node_target where record_id = #{recordId} and node = #{node}
    </select>

    <delete id="deleteByParam">
        delete from mp_devops_task_node_target
        <where>
            <if test=" id != null ">
                and id = #{id}
            </if>
            <if test=" recordId != null ">
                and record_id = #{recordId}
            </if>
            <if test=" node != null ">
                and node = #{node}
            </if>
        </where>
    </delete>

    <select id="getAllTaskBind" resultType="cn.cyberpeace.mp.devopscluster.po.VulnTaskTargetPO">
        select record_id recordId, record_name recordName from mp_devops_task_node_target group by record_id
    </select>

    <select id="getTaskBindByRecordId" resultType="cn.cyberpeace.mp.devopscluster.po.VulnTaskTargetPO">
        select * from mp_devops_task_node_target where record_id = #{recordId}
    </select>

</mapper>
