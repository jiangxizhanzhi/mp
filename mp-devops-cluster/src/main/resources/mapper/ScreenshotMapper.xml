<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cyberpeace.mp.devops.cluster.repository.ScreenshotMapper">

    <select id="queryUsedSpace" resultType="java.lang.Long">
        select
            sum(s.file_size)
        from
            mp_devops_screenshot s
    </select>

    <select id="queryByCreateTime" resultType="cn.cyberpeace.mp.devops.cluster.model.ScreenshotModel">
        select s.*
        from
            mp_devops_screenshot s
        <where>
            <if test=" createTime != null and createTime != ''">
                <![CDATA[
                    s.create_time < #{createTime}
                ]]>
            </if>
        </where>
    </select>

</mapper>