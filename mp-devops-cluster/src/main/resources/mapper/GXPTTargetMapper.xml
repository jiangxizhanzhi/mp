<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.devopscluster.repository.GXPTTargetMapper">

    <select id="findIdsByUuids" resultType="java.lang.String">
        select return_id from mp_devops_target where uuid in
        <foreach collection="param" item="item" index="index"  open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

</mapper>
