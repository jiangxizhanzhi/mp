<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.devopscluster.repository.MicrosoftAzureMapper">

    <update id="updateCloudTarget">
        UPDATE
            mp_devops_cloud_target
        SET
            <if test="param != null and param.name != null">
                name = #{param.name},
            </if>
            <if test="param != null and param.logo != null">
                logo = #{param.logo},
            </if>
            <if test="param != null and param.parentSystemType != null">
                system_type = #{param.parentSystemType},
            </if>
            <if test="param != null and param.parentSystemStatus != null">
                image_type = #{param.parentSystemStatus},
            </if>
            <if test="param != null and param.generations != null">
                reference_status = #{param.generations},
            </if>
            <if test="param != null and param.sku != null">
                support_export = #{param.sku},
            </if>
            <if test="param != null and param.createUser != null">
                system_architecure = #{param.createUser},
            </if>
                update_time = now()
        WHERE
            pk = #{pk}
    </update>

    <delete id="deleteByPk">
        DELETE
        FROM
            mp_devops_cloud_target
        WHERE
            pk = #{pk}
    </delete>

    <select id="getCloudTargetList" resultType="cn.cyberpeace.mp.devopscluster.po.DeviceCloudTargetPO">
        SELECT
            *
        FROM
            mp_devops_cloud_target
        <where>
            <if test="param != null and param.name != null and param.name != ''">
                and name like concat('%', #{param.name}, '%')
            </if>
            <if test="param != null and param.systemType != null and param.systemType != ''">
                and system_type = #{param.systemType}
            </if>
        </where>
        <if test="param != null and param.offset != null and param.pageSize != null">
            limit #{param.offset}, #{param.pageSize}
        </if>
    </select>

    <select id="getCloudTargetListTotal" resultType="java.lang.Integer">
        SELECT
        count(0)
        FROM
        mp_devops_cloud_target
        <where>
            <if test="param != null and param.name != null and param.name != ''">
                and name like concat('%', #{param.name}, '%')
            </if>
            <if test="param != null and param.systemType != null and param.systemType != ''">
                and system_type = #{param.systemType}
            </if>
        </where>
    </select>

    <select id="getSingleLayerList" resultType="com.alibaba.fastjson.JSONObject">
        SELECT
            e.code as parentSystemType,
            e.code_name
        FROM
            mp_sys_code_enum e
        WHERE
            e.parent_code = #{parentCode}
    </select>

    <select id="getCloudTargetByPk" resultType="cn.cyberpeace.mp.devopscluster.po.DeviceCloudTargetPO">
        SELECT
            *
        FROM
            mp_devops_cloud_target
        WHERE
            pk = #{pk}
    </select>

    <select id="getAlldata" resultType="cn.cyberpeace.mp.devopscluster.model.MpSysCodeEnum">
        WITH RECURSIVE recursion ( CODE, code_name, parent_code, remark, STATUS, LEVEL ) AS (
	SELECT
		T1.CODE,
		T1.code_name,
		T1.parent_code,
		T1.remark,
		T1.STATUS,
		T1.LEVEL
	FROM
		mp_sys_code_enum T1
	WHERE
		T1.CODE = #{code} UNION ALL
	SELECT
		T2.CODE,
		T2.code_name,
		T2.parent_code,
		T2.remark,
		T2.STATUS,
		T2.LEVEL
	FROM
		mp_sys_code_enum T2,
		recursion T3
	WHERE
		T2.parent_code = T3.CODE
	) SELECT
                  *
      FROM
                  recursion T
      ORDER BY
	              T.LEVEL
    </select>

    <select id="getSqlByCodes" resultType="cn.cyberpeace.mp.devopscluster.model.MpSysCodeEnum">
        SELECT
            code,remark
        FROM
            mp_sys_code_enum
        <where>
            <if test="param != null and param.size != 0">
                code in
                <foreach collection="param" item="item" open="(" close=")" separator=",">
                    #{item.code}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getCloudTargetListByCodes" resultType="cn.cyberpeace.mp.devopscluster.po.DeviceCloudTargetPO">
        SELECT
            *
        FROM
            mp_devops_cloud_target
        <where>
            <if test="param != null and param.size != 0">
                <foreach collection="param" item="item">
                    #{item.remark}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
