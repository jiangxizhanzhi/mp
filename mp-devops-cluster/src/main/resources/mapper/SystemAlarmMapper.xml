<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cyberpeace.mp.devopscluster.repository.SystemAlarmMapper">

    <select id="todayAlarmCount" resultType="cn.cyberpeace.mp.devopscluster.vo.AlarmCountVO">
        SELECT
            alarm_type,
            count(*) as alarm_count
        FROM
            mp_devops_system_alarm
        WHERE
            TO_DAYS( create_time ) = TO_DAYS(#{currentTime})
        GROUP BY
            alarm_type
    </select>
</mapper>