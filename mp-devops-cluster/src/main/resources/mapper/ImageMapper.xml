<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.devops.cluster.repository.ImageMapper">

    <resultMap id="BaseResultMap" type="cn.cyberpeace.mp.devops.cluster.model.TargetModel">
        <id column="pk" property="pk"/>
        <result column="id"  property="id"/>
        <result column="uuid"  property="uuid"/>
        <result column="name"  property="name"/>
        <result column="main_category"  property="mainCategory"/>
        <result column="sub_category" property="subCategory"/>
        <result column="third_category" property="thirdCategory"/>
        <result column="image_type" property="imageType"/>
        <result column="is_public" property="isPublic" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="quick_create_support" property="quickCreateSupport" />
        <result column="in_position" property="inPosition" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="reference_status" property="referenceStatus" />
        <result column="use_status" property="useStatus" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
    </resultMap>

    <sql id="commonTargetWhere">
        <where>
            <if test=" name != null and name != '' and likeName != false">
                and i.name like CONCAT('%',#{name},'%')
            </if>
            <if test=" name != null and name != '' and likeName == false">
                and i.name = #{name}
            </if>
            <if test=" mainCategory != null">
                and i.main_category = #{mainCategory}
            </if>
            <if test=" subCategory != null">
                and i.sub_category = #{subCategory}
            </if>
            <if test=" role != null">
                and i.role = #{role}
            </if>
            <if test=" thirdCategory != null">
                and i.third_category = #{thirdCategory}
            </if>
            <if test=" imageType != null and imageType != '' ">
                and i.image_type = #{imageType}
            </if>
            <if test=" searchType != null and searchType == 1 ">
                and i.image_type != 'entity'
            </if>
            <if test=" searchType != null and searchType == 2 ">
                and i.image_type = 'entity'
            </if>
            <if test=" inPosition != null  ">
                and i.in_position = #{inPosition}
            </if>
            <if test=" useStatus != null ">
                and i.use_status = #{useStatus}
            </if>
            <if test=" quickCreateSupport != null">
                and i.quick_create_support = #{quickCreateSupport}
            </if>
            <if test=" owner != null and searchPublicEnum == 1">
                and  i.is_public in (2)
            </if>
            <if test="systemType != null">
                AND i.system_type = #{systemType}
            </if>
            <if test="systemArchitecure != null">
                And i.system_architecure = #{systemArchitecure}
            </if>
            <if test="language != null">
                and i.language = #{language}
            </if>
            <if test="imageStatus != null">
                and i.image_status = #{imageStatus}
            </if>
            <if test="baseImageSupport != null and baseImageSupport == true">
                and i.image_source in (2,3)
            </if>
            <if test="targetCategory != null and targetCategory == 1">
                and i.is_import = 1
            </if>
            <if test="targetCategory != null and targetCategory == 2">
                and i.image_type = 'entity'
            </if>
            <if test="targetCategory != null and targetCategory == 3">
                and i.is_import = 0
            </if>
        </where>
    </sql>

    <sql id="commonTargetAuthWhere">

        <where>
            <if test=" name != null and name != '' and likeName != false">
                and i.name like CONCAT('%',#{name},'%')
            </if>
            <if test=" name != null and name != '' and likeName == false">
                and i.name = #{name}
            </if>
            <if test=" mainCategory != null">
                and i.main_category = #{mainCategory}
            </if>
            <if test=" subCategory != null">
                and i.sub_category = #{subCategory}
            </if>
            <if test=" thirdCategory != null">
                and i.third_category = #{thirdCategory}
            </if>
            <if test=" role != null">
                and i.role = #{role}
            </if>
            <if test=" thirdCategory != null">
                and i.third_category = #{thirdCategory}
            </if>
            <if test=" imageType != null and imageType != '' ">
                and i.image_type = #{imageType}
            </if>
            <if test=" searchType != null and searchType == 1 ">
                and i.image_type in ('vm','container','simple')
            </if>
            <if test=" searchType != null and searchType == 2 ">
                and i.image_type = 'entity'
            </if>
            <if test=" inPosition != null  ">
                and i.in_position = #{inPosition}
            </if>
            <if test=" useStatus != null ">
                and i.use_status = #{useStatus}
            </if>
            <if test=" quickCreateSupport != null">
                and i.quick_create_support = #{quickCreateSupport}
            </if>
            <if test=" owner != null and searchPublicEnum == 1">
                and  a.owner = #{owner}
            </if>
            <if test="systemType != null">
                AND i.system_type = #{systemType}
            </if>
            <if test="systemArchitecure != null">
                And i.system_architecure = #{systemArchitecure}
            </if>
            <if test="language != null">
                and i.language = #{language}
            </if>
            <if test="imageStatus != null">
                and i.image_status = #{imageStatus}
            </if>
            <if test="baseImageSupport != null and baseImageSupport == true">
                and i.image_source in (2,3)
            </if>
            <if test="targetCategory != null and targetCategory == 1">
                and i.is_import = 1
            </if>
            <if test="targetCategory != null and targetCategory == 2">
                and i.image_type = 'entity'
            </if>
            <if test="targetCategory != null and targetCategory == 3">
                and i.is_import = 0
            </if>
        </where>
    </sql>

    <sql id="commonTargetColumn">
        i.pk,i.id,i.uuid,i.name,i.main_category,i.sub_category,i.third_category,i.image_type,i.is_public,i.quick_create_support,
        i.in_position,i.reference_status,i.use_status,i.create_time
    </sql>
    
    <select id="totalCount" parameterType="cn.cyberpeace.mp.devops.cluster.dto.ImagePageDTO"  resultType="java.lang.Integer">
        select
               count(distinct i.pk)
        from
        (
        select
        <include refid="commonTargetColumn"/>
        from
        mp_devops_target i
        <include refid="commonTargetWhere"/>

        <if test=" owner != null">
            UNION
            SELECT
            <include refid="commonTargetColumn"/>
            FROM
            mp_devops_target_auth a
            inner join  mp_devops_target i on a.target = i.uuid
            <include refid="commonTargetAuthWhere"/>
        </if>
        ) as i
    </select>

    <select id="page" parameterType="cn.cyberpeace.mp.devops.cluster.dto.ImagePageDTO" resultMap="BaseResultMap">
        select
            <include refid="commonTargetColumn"/>
        from
        (
            select
                <include refid="commonTargetColumn"/>
            from
                mp_devops_target i
            <include refid="commonTargetWhere"/>

            <if test=" owner != null">
                UNION

                SELECT
                    <include refid="commonTargetColumn"/>
                FROM
                    mp_devops_target_auth a
                inner join  mp_devops_target i on a.target = i.uuid
                <include refid="commonTargetAuthWhere"/>
             </if>
        ) as i
        ORDER BY i.create_time desc
        <if test="offset != null and limit != null">
            limit #{offset}, #{limit}
        </if>
    </select>

    <select id="findByUuid" parameterType="java.lang.String" resultMap="BaseResultMap">
        select
        <include refid="commonTargetColumn"/>
        from
        mp_devops_target i
        where i.uuid = #{uuid}
    </select>

    <select id="findByUuids"  resultMap="BaseResultMap">
        select
        <include refid="commonTargetColumn"/>
        from
        mp_devops_target i
        <where>
            <if test="uuids != null and uuids.size > 0">
                i.uuid in
                <foreach collection="uuids" item="item" index="index"  open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <update id="updateById"
            parameterType="cn.cyberpeace.mp.devops.cluster.model.TargetModel">
        update mp_devops_target
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="mainCategory != null">
                main_category = #{mainCategory},
            </if>
            <if test="subCategory != null">
                sub_category = #{subCategory},
            </if>
            <if test="thirdCategory != null">
                third_category = #{thirdCategory},
            </if>
            <if test="imageType != null">
                image_type = #{imageType},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="isPublic != null">
                is_public = #{isPublic,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
            </if>
            <if test="quickCreateSupport != null">
                quick_create_support = #{quickCreateSupport},
            </if>
            <if test="inPosition != null">
                in_position = #{inPosition,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
            </if>
            <if test="useStatus != null">
                use_status = #{useStatus},
            </if>
            <if test="referenceStatus != null">
                reference_status = #{referenceStatus},
            </if>
            <if test="systemType != null">
                system_type = #{systemType},
            </if>
            <if test="systemArchitecure != null">
                system_architecure = #{systemArchitecure},
            </if>
            <if test="language != null">
                language = #{language},
            </if>
            <if test="imageStatus != null">
                image_status = #{imageStatus},
            </if>
            <if test="baseImageSupport != null">
                base_image_support = #{baseImageSupport},
            </if>
            <if test="initSupport != null">
                init_support = #{initSupport},
            </if>
            <if test="imageSource != null">
                image_source = #{imageSource},
            </if>
        </set>
        where uuid = #{uuid}
    </update>

    <update id="updateBatch"  parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update mp_devops_target
            <set>
                <if test="item.referenceStatus != null">
                    reference_status = #{item.referenceStatus},
                </if>
                <if test="item.useStatus != null">
                    use_status = #{item.useStatus,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
                </if>
            </set>
            where uuid = #{item.uuid}
        </foreach>
    </update>


    <delete id="delete" parameterType="cn.cyberpeace.mp.devops.cluster.dto.ImageDeleteDTO">
        delete from mp_devops_target
        <where>
            <if test="ids != null and ids.size > 0">
                uuid in
                <foreach collection="ids" item="item" index="index"  open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </delete>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into mp_devops_target( id, uuid, name, main_category,sub_category,third_category,
                                     role, image_type,is_public, quick_create_support,
                                     create_time, update_time, in_position,use_status,reference_status,
                                     system_type,system_architecure, language,image_status,base_image_support,
                                     init_support,image_source,is_import)
        VALUES
        <foreach collection="list" item="item" index="index"  separator=",">
        (
            #{item.id},#{item.uuid},#{item.name},#{item.mainCategory},#{item.subCategory},
            #{item.thirdCategory}, #{item.role},
            #{item.imageType},#{item.isPublic,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
            #{item.quickCreateSupport}, #{item.createTime},
            #{item.updateTime},#{item.inPosition,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
            #{item.useStatus,jdbcType=TINYINT,typeHandler=org.apache.ibatis.type.EnumOrdinalTypeHandler},
            #{item.referenceStatus}, #{item.systemType}, #{item.systemArchitecure},#{item.language}, #{item.imageStatus},
            #{item.baseImageSupport}, #{item.initSupport}, #{item.imageSource}, #{item.isImport}
        )
        </foreach>
    </insert>

    <!-- 靶标类型统计 -->
    <select id="countTarget" resultType="java.util.Map">
        select
            sum(case when t.image_type = 'container' then 1 else 0 end ) as container,
            sum(case when t.image_type = 'entity' then 1 else 0 end ) as entity,
            sum(case when t.image_type = 'vm' or t.image_type = 'simple'  then 1 else 0 end ) as vm,
            0 as tgm
        from mp_devops_target t
    </select>

    <!-- 虚拟靶标统计 -->
    <select id="countVmTarget" resultType="java.util.Map">
        SELECT
            sum( CASE WHEN t.main_category = 1 THEN 1 ELSE 0 END ) AS '1',
            sum( CASE WHEN t.main_category = 2 THEN 1 ELSE 0 END ) AS '2',
            sum( CASE WHEN t.main_category = 3 THEN 1 ELSE 0 END ) AS '3',
            sum( CASE WHEN t.main_category = 4 THEN 1 ELSE 0 END ) AS '4'
        FROM
            mp_devops_target t
        WHERE
            t.image_type IN ( 'vm', 'simple' )
           OR (t.sub_category = 53 AND t.image_type != 'entity')
    </select>

    <!-- 实体靶标统计 -->
    <select id="countEntityTarget" resultType="java.util.Map">
        select
            sum(case when t.main_category = 1 then 1 else 0 end ) as '1',
            sum(case when t.main_category = 2 then 1 else 0 end ) as '2',
            sum(case when t.main_category = 3 then 1 else 0 end ) as '3',
            sum(case when t.main_category = 4 then 1 else 0 end ) as '4'
        from mp_devops_target t where t.image_type = 'entity'
    </select>
</mapper>
