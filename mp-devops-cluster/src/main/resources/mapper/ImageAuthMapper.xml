<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.devops.cluster.repository.ImageAuthMapper">

    <select id="totalCount" resultType="cn.cyberpeace.mp.devops.cluster.model.ImageAuthTotalCount">
        select
            a.target as target,
            count(a.pk) as total
        from
            mp_devops_target_auth a
        where a.target  in
            <foreach collection="ids" item="item" index="index"  open="(" separator="," close=")">
                #{item}
            </foreach>
        group by a.target
    </select>
</mapper>
