<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.repository.FlowInfoMapper">

    <select id="selectByFlowIds" resultType="cn.cyberpeace.mp.flow.model.FlowInfoModel">
        select f.* from mp_flow_flow_info f
        <where>
            1 = 1
            <if test="flowIds != null and flowIds.size() > 0">
                AND f.id in
                <foreach item="id" index="index" collection="flowIds" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByTitle" resultType="cn.cyberpeace.mp.flow.model.FlowInfoModel">
        select f.* from mp_flow_flow_info f
        <where>
            f.title = #{title}
        </where>
    </select>

    <select id="selectByTitles" resultType="cn.cyberpeace.mp.flow.model.FlowInfoModel">
        select f.* from mp_flow_flow_info f
        <where>
            1 = 1
            <if test="titleList != null and titleList.size() > 0">
                AND f.title in
                <foreach item="title" index="index" collection="titleList" open="(" separator="," close=")">
                    #{title}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
