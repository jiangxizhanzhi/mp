<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.repository.FlowTaskMapper">

    <select id="listByFlowIds" resultType="cn.cyberpeace.mp.flow.model.FlowTaskModel">
        select f.* from mp_flow_task f
        <where>
            1 = 1
            <if test="flowIds != null and flowIds.size() > 0">
                AND f.flow_id in
                <foreach item="id" index="index" collection="flowIds" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

    <update id="increaseRunningCount">
        update mp_flow_task
        set running_count = running_count + 1
        where id = #{taskId,jdbcType=VARCHAR}
    </update>

    <update id="batchUpdateTaskStatus">
        update mp_flow_task
        <set>
            <if test="taskStatus != null">
                task_status = #{taskStatus},
            </if>
            <if test="runCount != null">
                running_count = running_count + 1,
            </if>
        </set>
        where id in
        <foreach item="id" index="index" collection="taskIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="updateTaskInfo" parameterType="cn.cyberpeace.mp.flow.model.FlowTaskModel">
        update mp_flow_task
        <set>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="taskDesc != null">
                task_desc = #{taskDesc},
            </if>
            <if test="actuatorId != null">
                actuator_id = #{actuatorId},
            </if>
            <if test="flowId != null">
                flow_id = #{flowId},
            </if>
            <if test="flowPortId != null">
                flow_port_id = #{flowPortId},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="flowPlatform != null">
                flow_platform = #{flowPlatform},
            </if>
            <if test="thirdFlowId != null">
                third_flow_id = #{thirdFlowId},
            </if>
            <if test="thirdFlowName != null">
                third_flow_name = #{thirdFlowName},
            </if>
            <if test="thirdTaskId != null">
                third_task_id = #{thirdTaskId},
            </if>
            <if test="count != null">
                count = #{count},
            </if>
            <if test="delay != null">
                delay = #{delay},
            </if>
            <if test="intervalTime != null">
                interval_time = #{intervalTime},
            </if>
            <if test="taskStatus != null">
                task_status = #{taskStatus},
            </if>
            <if test="runningCount != null">
                running_count = #{runningCount},
            </if>
            <if test="originIps != null">
                origin_ips = #{originIps},
            </if>
            <if test="targetIps != null">
                target_ips = #{targetIps},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>
