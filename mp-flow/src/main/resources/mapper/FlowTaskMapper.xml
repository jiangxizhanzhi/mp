<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.repository.FlowTaskMapper">

    <select id="listByFlowIds" resultType="cn.cyberpeace.mp.flow.model.FlowTaskModel">
        select f.* from mp_flow_task f
        <where>
            1 == 1
            <if test="flowIds != null and flowIds.size() > 0">
                AND f.flow_id in
                <foreach item="id" index="index" collection="flowIds" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>

</mapper>
