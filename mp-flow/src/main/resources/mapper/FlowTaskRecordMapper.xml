<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.v2.repository.FlowTaskRecordMapper">
    <select id="countStartTask" resultType="java.lang.Long">
    	select count(*) from mp_flow_flow_task_record where status != 3
    </select>
    
    <select id="generatorTaskList" resultType="cn.cyberpeace.mp.flow.v2.model.FlowTaskRecordModel">
    	select * from mp_flow_flow_task_record where status != 3
    </select>
</mapper>
