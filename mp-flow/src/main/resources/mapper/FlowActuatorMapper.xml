<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.repository.FlowActuatorMapper">

    <select id="selectBySceneId" resultType="cn.cyberpeace.mp.flow.model.FlowActuatorModel">
        select f.* from mp_flow_actuator f
        <where>
            f.scene_id = #{sceneId}
        </where>
    </select>

</mapper>
