<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.flow.repository.EsCollectionDataStorageMapper">

    <select id="listByDate" resultType="cn.cyberpeace.mp.flow.model.EsCollectionDataStorageModel">
        select pk, id, `date`, channel, status, create_time, update_time
        from mp_es_collection_data_storage
        where `date` = #{date}
    </select>
</mapper>
