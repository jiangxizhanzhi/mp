<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.base.repository.CommonMapper">
    <sql id="filterCondition">
        <trim prefix="WHERE" prefixOverrides="AND" suffixOverrides="AND">
            <if test="condition.andi != null and !condition.andi.isEmpty()">
                <include refid="cn.cyberpeace.mp.base.and" />
            </if>
        </trim>
    </sql>
    <select id="list" resultType="map">
        <include refid="cn.cyberpeace.mp.base.listTemplate" />
        <include refid="filterCondition" />
        <include refid="cn.cyberpeace.mp.base.group" />
        <include refid="cn.cyberpeace.mp.base.order" />
        <include refid="cn.cyberpeace.mp.base.pagination" />
    </select>
    <select id="total" resultType="int">
        <include refid="cn.cyberpeace.mp.base.totalTemplate" />
        <include refid="filterCondition" />
    </select>
    <select id="exist" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM ${table} <include refid="filterCondition" /> LIMIT 1)
    </select>
    <select id="get" resultType="map">
        <include refid="cn.cyberpeace.mp.base.getTemplate" />
    </select>
    <insert id="create">
        <include refid="cn.cyberpeace.mp.base.createTemplate" />
    </insert>
    <update id="update">
        <include refid="cn.cyberpeace.mp.base.updateTemplate" />
    </update>
    <delete id="delete">
        <include refid="cn.cyberpeace.mp.base.deleteTemplate" />
    </delete>
    <insert id="bulkCreate">
        <include refid="cn.cyberpeace.mp.base.bulkCreateTemplate" />
    </insert>
    <update id="bulkUpdate">
        <include refid="cn.cyberpeace.mp.base.bulkUpdateTemplate" />
    </update>
    <delete id="bulkDelete">
        <include refid="cn.cyberpeace.mp.base.bulkDeleteTemplate" />
    </delete>
    <update id="filterUpdate">
        UPDATE ${table}
        SET <include refid="cn.cyberpeace.mp.base.updateFields" />
        <include refid="filterCondition" />
        <include refid="cn.cyberpeace.mp.base.group" />
        <include refid="cn.cyberpeace.mp.base.order" />
        <include refid="cn.cyberpeace.mp.base.pagination" />
    </update>
    <delete id="filterDelete">
        DELETE FROM ${table} <include refid="filterCondition" />
        <include refid="cn.cyberpeace.mp.base.group" />
        <include refid="cn.cyberpeace.mp.base.order" />
        <include refid="cn.cyberpeace.mp.base.pagination" />
    </delete>
</mapper>
