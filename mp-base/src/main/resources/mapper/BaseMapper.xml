    <sql id="selectFields">
        <if test="selectFields != null">
            <foreach item="field" index="index" collection="selectFields" open="" separator="," close="">${field}</foreach>
        </if>
        <if test="selectFields == null">*</if>
    </sql>
    <sql id="countField">
        <if test="countField != null">count(${countField})</if>
        <if test="countField == null">count(*)</if>
    </sql>
    <sql id="countStar"><if test="true">count(*)</if></sql>
