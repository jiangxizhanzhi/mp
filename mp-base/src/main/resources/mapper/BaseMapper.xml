                            <when test="andCond.connector == 'notEndsWith'">${andCond.fieldName} NOT LIKE BINARY CONCAT('%', #{andCond.fieldValue})</when>
                            <when test="andCond.connector == 'notIEndsWith'">${andCond.fieldName} NOT LIKE CONCAT('%', #{andCond.fieldValue})</when>
                            <otherwise>${andCond.fieldName} ${andCond.connector} #{andCond.fieldValue}</otherwise>
