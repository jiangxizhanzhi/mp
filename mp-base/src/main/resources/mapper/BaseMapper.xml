                                    <when test="orCond.connector == 'notContains'">${orCond.fieldName} NOT LIKE BINARY CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notIContains'">${orCond.fieldName} NOT LIKE CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notStartsWith'">${orCond.fieldName} NOT LIKE BINARY CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notIStartsWith'">${orCond.fieldName} NOT LIKE CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notEndsWith'">${orCond.fieldName} NOT LIKE BINARY CONCAT('%', #{orCond.fieldValue})</when>
                                    <when test="orCond.connector == 'notIEndsWith'">${orCond.fieldName} NOT LIKE CONCAT('%', #{orCond.fieldValue})</when>
                                    <otherwise>${orCond.fieldName} ${orCond.connector} #{orCond.fieldValue}</otherwise>
                                </choose>
                            </otherwise>
                        </choose>
                    </foreach>
                </if>
                <if test="cond.name == 'and'">
                    <foreach item="andCond" index="index" collection="cond.conds" open="(" separator=" AND " close=")">
                        <choose>
                            <when test="andCond.connector == 'link'">${andCond.fieldName} = ${andCond.fieldValue}</when>
