<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.base">
    <sql id="selectFields">
        <if test="selectFields != null">
            <foreach item="field" index="index" collection="selectFields" open="" separator="," close="">${field}</foreach>
        </if>
        <if test="selectFields == null">*</if>
    </sql>
    <sql id="countField">
        <if test="countField != null">count(${countField})</if>
        <if test="countField == null">count(*)</if>
    </sql>
    <sql id="countStar"><if test="true">count(*)</if></sql>
    <sql id="countPk"><if test="true">count(pk)</if></sql>
    <sql id="and">
        <if test="condition.andi != null and !condition.andi.isEmpty()">
            <foreach item="cond" index="index" collection="condition.andi.conds" open="(" separator=" AND " close=")">
                <if test="cond.name == 'cond'">
                    <choose>
                        <when test="cond.connector == 'link'">${cond.fieldName} = ${cond.fieldValue}</when>
                        <when test="cond.connector == 'in'">${cond.fieldName} IN <foreach
                                item="value" index="index" collection="cond.fieldValue"
                                open="(" separator="," close=")">#{value}</foreach></when>
                        <when test="cond.connector == 'notIn'">${cond.fieldName} NOT IN <foreach
                                item="value" index="index" collection="cond.fieldValue"
                                open="(" separator="," close=")">#{value}</foreach></when>
                        <when test="cond.connector == 'contains'">${cond.fieldName} LIKE BINARY CONCAT('%', #{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'iContains'">${cond.fieldName} LIKE CONCAT('%', #{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'startsWith'">${cond.fieldName} LIKE BINARY CONCAT(#{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'iStartsWith'">${cond.fieldName} LIKE CONCAT(#{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'endsWith'">${cond.fieldName} LIKE BINARY CONCAT('%', #{cond.fieldValue})</when>
                        <when test="cond.connector == 'iEndsWith'">${cond.fieldName} LIKE CONCAT('%', #{cond.fieldValue})</when>
                        <when test="cond.connector == 'notContains'">${cond.fieldName} NOT LIKE BINARY CONCAT('%', #{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'notIContains'">${cond.fieldName} NOT LIKE CONCAT('%', #{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'notStartsWith'">${cond.fieldName} NOT LIKE BINARY CONCAT(#{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'notIStartsWith'">${cond.fieldName} NOT LIKE CONCAT(#{cond.fieldValue}, '%')</when>
                        <when test="cond.connector == 'notEndsWith'">${cond.fieldName} NOT LIKE BINARY CONCAT('%', #{cond.fieldValue})</when>
                        <when test="cond.connector == 'notIEndsWith'">${cond.fieldName} NOT LIKE CONCAT('%', #{cond.fieldValue})</when>
                        <otherwise>${cond.fieldName} ${cond.connector} #{cond.fieldValue}</otherwise>
                    </choose>
                </if>
                <if test="cond.name == 'or'">
                    <foreach item="orCond" index="index" collection="cond.conds" open="(" separator=" OR " close=")">
                        <choose>
                            <when test="orCond.name == 'and'">
                                <foreach collection="orCond.conds" separator=" AND " open="(" close=")" item="andCond">
                                    <choose>
                                        <when test="andCond.connector == 'link'">${andCond.fieldName} = ${andCond.fieldValue}</when>
                                        <when test="andCond.connector == 'in'">${andCond.fieldName} IN <foreach
                                                item="value" index="index" collection="andCond.fieldValue"
                                                open="(" separator="," close=")">#{value}</foreach></when>
                                        <when test="andCond.connector == 'notIn'">${andCond.fieldName} NOT IN <foreach
                                                item="value" index="index" collection="andCond.fieldValue"
                                                open="(" separator="," close=")">#{value}</foreach></when>
                                        <when test="andCond.connector == 'contains'">${andCond.fieldName} LIKE BINARY CONCAT('%', #{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'iContains'">${andCond.fieldName} LIKE CONCAT('%', #{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'startsWith'">${andCond.fieldName} LIKE BINARY CONCAT(#{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'iStartsWith'">${andCond.fieldName} LIKE CONCAT(#{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'endsWith'">${andCond.fieldName} LIKE BINARY CONCAT('%', #{andCond.fieldValue})</when>
                                        <when test="andCond.connector == 'iEndsWith'">${andCond.fieldName} LIKE CONCAT('%', #{andCond.fieldValue})</when>
                                        <when test="andCond.connector == 'notContains'">${andCond.fieldName} NOT LIKE BINARY CONCAT('%', #{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'notIContains'">${andCond.fieldName} NOT LIKE CONCAT('%', #{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'notStartsWith'">${andCond.fieldName} NOT LIKE BINARY CONCAT(#{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'notIStartsWith'">${andCond.fieldName} NOT LIKE CONCAT(#{andCond.fieldValue}, '%')</when>
                                        <when test="andCond.connector == 'notEndsWith'">${andCond.fieldName} NOT LIKE BINARY CONCAT('%', #{andCond.fieldValue})</when>
                                        <when test="andCond.connector == 'notIEndsWith'">${andCond.fieldName} NOT LIKE CONCAT('%', #{andCond.fieldValue})</when>
                                        <otherwise>${andCond.fieldName} ${andCond.connector} #{andCond.fieldValue}</otherwise>
                                    </choose>
                                </foreach>
                            </when>
                            <otherwise>
                                <choose>
                                    <when test="orCond.connector == 'link'">${orCond.fieldName} = ${orCond.fieldValue}</when>
                                    <when test="orCond.connector == 'in'">${orCond.fieldName} IN <foreach
                                            item="value" index="index" collection="orCond.fieldValue"
                                            open="(" separator="," close=")">#{value}</foreach></when>
                                    <when test="orCond.connector == 'notIn'">${orCond.fieldName} NOT IN <foreach
                                            item="value" index="index" collection="orCond.fieldValue"
                                            open="(" separator="," close=")">#{value}</foreach></when>
                                    <when test="orCond.connector == 'contains'">${orCond.fieldName} LIKE BINARY CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'iContains'">${orCond.fieldName} LIKE CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'startsWith'">${orCond.fieldName} LIKE BINARY CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'iStartsWith'">${orCond.fieldName} LIKE CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'endsWith'">${orCond.fieldName} LIKE BINARY CONCAT('%', #{orCond.fieldValue})</when>
                                    <when test="orCond.connector == 'iEndsWith'">${orCond.fieldName} LIKE CONCAT('%', #{orCond.fieldValue})</when>
                                    <when test="orCond.connector == 'notContains'">${orCond.fieldName} NOT LIKE BINARY CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notIContains'">${orCond.fieldName} NOT LIKE CONCAT('%', #{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notStartsWith'">${orCond.fieldName} NOT LIKE BINARY CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notIStartsWith'">${orCond.fieldName} NOT LIKE CONCAT(#{orCond.fieldValue}, '%')</when>
                                    <when test="orCond.connector == 'notEndsWith'">${orCond.fieldName} NOT LIKE BINARY CONCAT('%', #{orCond.fieldValue})</when>
                                    <when test="orCond.connector == 'notIEndsWith'">${orCond.fieldName} NOT LIKE CONCAT('%', #{orCond.fieldValue})</when>
                                    <otherwise>${orCond.fieldName} ${orCond.connector} #{orCond.fieldValue}</otherwise>
                                </choose>
                            </otherwise>
                        </choose>
                    </foreach>
                </if>
                <if test="cond.name == 'and'">
                    <foreach item="andCond" index="index" collection="cond.conds" open="(" separator=" AND " close=")">
                        <choose>
                            <when test="andCond.connector == 'link'">${andCond.fieldName} = ${andCond.fieldValue}</when>
                            <when test="andCond.connector == 'in'">${andCond.fieldName} IN <foreach
                                    item="value" index="index" collection="andCond.fieldValue"
                                    open="(" separator="," close=")">#{value}</foreach></when>
                            <when test="andCond.connector == 'notIn'">${andCond.fieldName} NOT IN <foreach
                                    item="value" index="index" collection="andCond.fieldValue"
                                    open="(" separator="," close=")">#{value}</foreach></when>
                            <when test="andCond.connector == 'contains'">${andCond.fieldName} LIKE BINARY CONCAT('%', #{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'iContains'">${andCond.fieldName} LIKE CONCAT('%', #{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'startsWith'">${andCond.fieldName} LIKE BINARY CONCAT(#{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'iStartsWith'">${andCond.fieldName} LIKE CONCAT(#{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'endsWith'">${andCond.fieldName} LIKE BINARY CONCAT('%', #{andCond.fieldValue})</when>
                            <when test="andCond.connector == 'iEndsWith'">${andCond.fieldName} LIKE CONCAT('%', #{andCond.fieldValue})</when>
                            <when test="andCond.connector == 'notContains'">${andCond.fieldName} NOT LIKE BINARY CONCAT('%', #{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'notIContains'">${andCond.fieldName} NOT LIKE CONCAT('%', #{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'notStartsWith'">${andCond.fieldName} NOT LIKE BINARY CONCAT(#{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'notIStartsWith'">${andCond.fieldName} NOT LIKE CONCAT(#{andCond.fieldValue}, '%')</when>
                            <when test="andCond.connector == 'notEndsWith'">${andCond.fieldName} NOT LIKE BINARY CONCAT('%', #{andCond.fieldValue})</when>
                            <when test="andCond.connector == 'notIEndsWith'">${andCond.fieldName} NOT LIKE CONCAT('%', #{andCond.fieldValue})</when>
                            <otherwise>${andCond.fieldName} ${andCond.connector} #{andCond.fieldValue}</otherwise>
                        </choose>
                    </foreach>
                </if>
            </foreach>
        </if>
    </sql>
    <sql id="group">
        <if test="condition.group != null and !condition.group.isEmpty()">
            GROUP BY <foreach item="groupField" index="index" collection="condition.group.groupFields"
                              open="" separator="," close="">${groupField}</foreach>
        </if>
    </sql>
    <sql id="order">
        <if test="condition.order != null and !condition.order.isEmpty()">
            ORDER BY <foreach item="order" index="index" collection="condition.order.orders"
                              open="" separator="," close="">${order}</foreach>
        </if>
    </sql>
    <sql id="pagination">
        <if test="condition.pagination != null">
            <if test="condition.pagination.limit != null">LIMIT #{condition.pagination.limit}</if>
            <if test="condition.pagination.offset != null">OFFSET #{condition.pagination.offset}</if>
        </if>
    </sql>
    <sql id="idFilter">
        <if test="true">id = #{id}</if>
    </sql>
    <sql id="idsFilter">
        <if test="ids != null">id IN
            <foreach item="id" index="index" collection="ids"
                     open="(" separator="," close=")">#{id}</foreach>
        </if>
    </sql>
    <sql id="createFields">
        <if test="createFields != null">
            <foreach item="field" index="index" collection="createFields"
                     open="(" separator="," close=")">${field}</foreach>
        </if>
    </sql>
    <sql id="createFieldValues">
        <foreach item="fieldValue" index="index" collection="createFieldValues"
                 open="(" separator="," close=")">#{fieldValue}</foreach>
    </sql>
    <sql id="updateFields">
        <foreach item="field" index="index" collection="updateFields"
                 open="" separator="," close="">
            <if test="field != 'id'">
                ${field} = #{updateFieldValues[${index}]}
            </if>
        </foreach>
    </sql>

    <sql id="listTemplate">
        SELECT <if test="condition.distinct">DISTINCT</if> <include refid="cn.cyberpeace.mp.base.selectFields" /> FROM ${table}
    </sql>
    <sql id="totalTemplate">
        SELECT <include refid="cn.cyberpeace.mp.base.countStar" /> FROM ${table}
    </sql>
    <sql id="getTemplate">
        SELECT <include refid="cn.cyberpeace.mp.base.selectFields" /> FROM ${table}
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="createTemplate">
        INSERT INTO ${table} <include refid="cn.cyberpeace.mp.base.createFields" />
        VALUES <include refid="cn.cyberpeace.mp.base.createFieldValues" />
    </sql>
    <sql id="updateTemplate">
        UPDATE ${table}
        SET <include refid="cn.cyberpeace.mp.base.updateFields" />
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="deleteTemplate">
        DELETE FROM ${table} WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="bulkCreateTemplate">
        INSERT INTO ${table} <include refid="cn.cyberpeace.mp.base.createFields" />
        VALUES
        <foreach item="createFieldValues" index="index" collection="createFieldValuesList"
                 open="" separator="," close="">
            <include refid="cn.cyberpeace.mp.base.createFieldValues">
                <property name="createFieldValues" value="createFieldValues"/>
            </include>
        </foreach>
    </sql>
    <sql id="bulkUpdateTemplate">
        UPDATE ${table} JOIN
        (<foreach item="updateFieldValues" index="rowIndex" collection="updateFieldValuesList"
                  open="" separator=" UNION " close="">
        SELECT
        <foreach item="updateFieldValue" index="fieldIndex" collection="updateFieldValues"
                 open="" separator="," close="">
            #{updateFieldValue} AS #{updateFields[${fieldIndex}]}
        </foreach>
    </foreach>) a USING(id)
        SET
        <foreach item="field" index="index" collection="updateFields"
                 open="" separator="," close="">
            <if test="field != 'id'">${table}.${field} = a.${field}</if>
        </foreach>
    </sql>
    <sql id="bulkDeleteTemplate">
        DELETE FROM ${table} WHERE <include refid="cn.cyberpeace.mp.base.idsFilter" />
    </sql>
</mapper>
