<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.base">
    <sql id="selectFields">
        <if test="selectFields != null">
            <foreach item="field" index="index" collection="selectFields"
                     open="" separator="," close="">${field}</foreach>
        </if>
        <if test="selectFields == null">*</if>
    </sql>
    <sql id="totalField">count(*)</sql>
    <sql id="search">
        <if test="condition.search != null and !condition.search.isEmpty()">
            <foreach item="field" index="index" collection="condition.search.searchFields"
                     open="" separator="OR" close="">
                ${field} LIKE #{condition.search.searchPattern}
            </foreach>
        </if>
    </sql>
    <sql id="order">
        <if test="condition.order != null and !condition.order.isEmpty()">
            ORDER BY <foreach item="order" index="index" collection="condition.order.orders"
                     open="" separator="," close="">${order}</foreach>
        </if>
    </sql>
    <sql id="pagination">
        <if test="condition.pagination != null">
            <if test="condition.pagination.limit != null">LIMIT #{condition.pagination.limit}</if>
            <if test="condition.pagination.offset != null">OFFSET #{condition.pagination.offset}</if>
        </if>
    </sql>
    <sql id="idFilter">
        <if test="true">id = #{id}</if>
    </sql>
    <sql id="idsFilter">
        <if test="ids != null">id IN
            <foreach item="id" index="index" collection="ids"
                     open="(" separator="," close=")">#{id}</foreach>
        </if>
    </sql>
    <sql id="createFields">
        <if test="createFields != null">
            <foreach item="field" index="index" collection="createFields"
                     open="(" separator="," close=")">${field}</foreach>
        </if>
    </sql>
    <sql id="createFieldValues">
        <foreach item="fieldValue" index="index" collection="createFieldValues"
                 open="(" separator="," close=")">#{fieldValue}</foreach>
    </sql>
    <sql id="updateFields">
        <foreach item="field" index="index" collection="updateFields"
                 open="" separator="," close="">
            <if test="field != 'id'">
                ${field} = #{updateFieldValues[${index}]}
            </if>
        </foreach>
    </sql>

    <sql id="listTemplate">
        SELECT <include refid="cn.cyberpeace.mp.base.selectFields" /> FROM ${table}
    </sql>
    <sql id="totalTemplate">
        SELECT <include refid="cn.cyberpeace.mp.base.totalField" /> FROM ${table}
    </sql>
    <sql id="getTemplate">
        SELECT <include refid="cn.cyberpeace.mp.base.selectFields" /> FROM ${table}
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="createTemplate">
        INSERT INTO ${table} <include refid="cn.cyberpeace.mp.base.createFields" />
        VALUES <include refid="cn.cyberpeace.mp.base.createFieldValues" />
    </sql>
    <sql id="updateTemplate">
        UPDATE ${table}
        SET <include refid="cn.cyberpeace.mp.base.updateFields" />
        WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="deleteTemplate">
        DELETE FROM ${table} WHERE <include refid="cn.cyberpeace.mp.base.idFilter" />
    </sql>
    <sql id="bulkCreateTemplate">
        INSERT INTO ${table} <include refid="cn.cyberpeace.mp.base.createFields" />
        VALUES
        <foreach item="createFieldValues" index="index" collection="createFieldValuesList"
                 open="" separator="," close="">
            <include refid="cn.cyberpeace.mp.base.createFieldValues">
                <property name="createFieldValues" value="createFieldValues"/>
            </include>
        </foreach>
    </sql>
    <sql id="bulkUpdateTemplate">
        UPDATE ${table} JOIN
        (<foreach item="updateFieldValues" index="rowIndex" collection="updateFieldValuesList"
                 open="" separator="UNION" close="">
            SELECT
            <foreach item="updateFieldValue" index="fieldIndex" collection="updateFieldValues"
                 open="" separator="," close="">
                #{updateFieldValue} AS #{updateFields[${fieldIndex}]}
            </foreach>
        </foreach>) a USING(id)
        SET
        <foreach item="field" index="index" collection="updateFields"
                 open="" separator="," close="">
            <if test="field != 'id'">${table}.${field} = a.${field}</if>
        </foreach>
    </sql>
    <sql id="bulkDeleteTemplate">
        DELETE FROM ${table} WHERE <include refid="cn.cyberpeace.mp.base.idsFilter" />
    </sql>
</mapper>
