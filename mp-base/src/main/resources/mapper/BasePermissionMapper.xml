<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="cn.cyberpeace.mp.base.repository.BasePermissionMapper">
    <sql id="filterPermissionCondition">
        <trim prefix="WHERE" prefixOverrides="AND" suffixOverrides="AND">
            <if test="condition.andi != null and !condition.andi.isEmpty()">
                <include refid="cn.cyberpeace.mp.base.and" />
            </if>
            AND p.owner = #{owner}
        </trim>
    </sql>
    <select id="listPerm" resultType="map">
        <include refid="cn.cyberpeace.mp.base.listTemplate" />
        <include refid="filterPermissionCondition" />
        <include refid="cn.cyberpeace.mp.base.group" />
        <include refid="cn.cyberpeace.mp.base.order" />
        <include refid="cn.cyberpeace.mp.base.pagination" />
    </select>
    <select id="total" resultType="int">
        <include refid="cn.cyberpeace.mp.base.totalTemplate" />
        <include refid="filterPermissionCondition" />
    </select>
</mapper>
